# Copy to `.env.production` (or set in your host's dashboard) to serve the
# question papers from the gated server instead of shipping them statically.

# Where the app should fetch subject/index/search JSON from.
#   Default (static):      ./data
#   Gated server:          /api/data
VITE_DATA_BASE=/api/data

# Show the access-code login screen and gate all data on a valid session.
VITE_REQUIRE_AUTH=true

# Only needed if the API lives on a different origin than the app.
# VITE_API_BASE=https://your-api.example.com
