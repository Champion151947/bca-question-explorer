{
  "name": "bca-question-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Unofficial BCA question-paper pattern explorer for Calicut University students.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build",
    "encrypt": "node scripts/encrypt-data.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "serve": "node server/serve.mjs"
  },
  "dependencies": {
    "minisearch": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5"
  }
}
